# ── DigiAjo Global — cPanel / LiteSpeed / Apache SPA Routing ──────────────────

# 1. Catch-all 404 Fallback Handler for LiteSpeed / Apache
ErrorDocument 404 /index.html

# 2. Mod_Rewrite Rules for Single Page Application (React Router)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to real files and directories (PHP API, CSS, JS, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all virtual SPA routes (e.g. /admin, /login, /dashboard) to root /index.html
  RewriteRule ^(.*)$ /index.html [L,QSA]
</IfModule>

# Disable Directory Index Browsing
Options -Indexes

# Default Charset
AddDefaultCharset UTF-8
