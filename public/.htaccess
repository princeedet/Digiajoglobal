# ── DigiAjo Global — cPanel / LiteSpeed / Apache SPA Routing ──────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite if requested file or directory actually exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs (e.g. /admin, /login, /dashboard, /register) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Disable Directory Index Browsing
Options -Indexes

# Default Charset
AddDefaultCharset UTF-8
